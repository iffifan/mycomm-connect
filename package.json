{
  "name": "@mycomm/connect",
  "version": "1.0.0",
  "description": "Drop-in widget that lets your users pair their phone and connect its SIM to MyComm, through a connect session created by your server.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/mycomm-connect.js",
  "module": "./dist/mycomm-connect.js",
  "types": "./dist/mycomm-connect.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mycomm-connect.d.ts",
      "import": "./dist/mycomm-connect.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "keywords": [
    "mycomm",
    "sms",
    "web-component",
    "pairing",
    "widget"
  ],
  "homepage": "https://mycomm.cogneer.tech/docs",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit -p jsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
