#!/usr/bin/env bash
# Runs npm in a container, so nothing Node has to be installed on the host.
#
#   ./dev npm install     ./dev test     ./dev lint     ./dev build     ./dev check (all three)
set -euo pipefail
cd "$(dirname "$0")"

run() {
    docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e npm_config_cache=/tmp/npm -v "$PWD":/app -w /app "${MYCOMM_NODE_IMAGE:-node:22}" "$@"
}

cmd="${1:-help}"
shift || true
case "$cmd" in
    npm) run npm "$@" ;;
    test) run npx vitest run "$@" ;;
    lint) run npx tsc --noEmit -p jsconfig.json ;;
    build) run node build.mjs ;;
    check) "$0" lint && "$0" test && "$0" build ;;
    *) sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
